{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "configs": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "entitlements": {
          ".write": false
        },
        "games": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "liveSessions": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "overlays": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "profile": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || newData.child('email').val() == auth.token.email"
        },
        "profiles": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "subscription": {
          ".write": false
        },
        "workspaceProfiles": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "premiumSeats": {
      "$email": {
        ".read": false,
        ".write": false
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && data.child('uid').val() == auth.uid && (!newData.exists() || newData.child('uid').val() == auth.uid)))"
      }
    },
    "site": {
      "adminSettings": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'alexandre.leuridan@gmail.com'",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'alexandre.leuridan@gmail.com'"
      },
      "publicVisibility": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'alexandre.leuridan@gmail.com'"
      },
      "gameCheatAccess": {
        ".read": false,
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'alexandre.leuridan@gmail.com'",
        "$emailHash": {
          ".read": "auth != null && auth.token.email_verified == true",
          ".validate": "newData.val() == true"
        }
      },
      "adminCommerce": {
        "history": {
          ".indexOn": "savedAt"
        }
      }
    },
    "serverOnly": {
      ".read": false,
      ".write": false
    },
    "publicOverlays": {
      "$uid": {
        "$overlayId": {
          ".read": true,
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "publicLiveDirectory": {
      ".indexOn": "updatedAt",
      ".read": "query.orderByChild == 'updatedAt' && query.startAt != null && query.limitToLast != null && query.limitToLast >= 1 && query.limitToLast <= 100 && query.limitToFirst == null",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['protocolVersion', 'instanceId', 'updatedAt', 'streams'])",
        "protocolVersion": {
          ".validate": "newData.val() == 1"
        },
        "instanceId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,80}$/)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 5000"
        },
        "streams": {
          ".validate": "newData.hasChild('tiktok') || newData.hasChild('kick')",
          "tiktok": {
            ".validate": "newData.hasChildren(['username', 'avatarUrl'])",
            "username": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.]{1,80}$/)"
            },
            "avatarUrl": {
              ".validate": "newData.isString() && newData.val().length <= 1000 && (newData.val() == '' || (newData.val().length > 8 && newData.val().beginsWith('https://') && newData.val().matches(/^[!-~]+$/) && !newData.val().contains('@')))"
            },
            "viewers": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "kick": {
            ".validate": "newData.hasChildren(['username', 'avatarUrl'])",
            "username": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_.-]{1,160}$/)"
            },
            "avatarUrl": {
              ".validate": "newData.isString() && newData.val().length <= 1000 && (newData.val() == '' || (newData.val().length > 8 && newData.val().beginsWith('https://') && newData.val().matches(/^[!-~]+$/) && !newData.val().contains('@')))"
            },
            "viewers": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publicOverlayRelay": {
      "$channel": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid && (!newData.exists() || newData.child('ownerUid').val() == auth.uid)))",
        ".validate": "!newData.exists() || (newData.child('ownerUid').isString() && newData.child('ownerUid').val().length <= 128 && (newData.child('protocolVersion').val() == 1 || newData.child('protocolVersion').val() == 2))"
      }
    }
  }
}
