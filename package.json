{
  "name": "shenpulse",
  "productName": "ShenPulse",
  "version": "1.0.9",
  "description": "Plateforme locale d'interactions pour livestreams et jeux",
  "main": "src/main/main.js",
  "author": "Alexandre Leuridan",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "npm run games:build && npm run assets && npm run brand:dev",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-packaged-dev.ps1",
    "brand:dev": "node scripts/brand-dev-executable.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "lint": "node scripts/lint.js",
    "verify": "npm run lint && npm test",
    "games:build": "vite build --config vite.games.config.mjs",
    "assets": "node scripts/generate-assets.js",
    "build:dir": "npm run games:build && npm run assets && electron-builder --win dir --x64",
    "package:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-appxupload.ps1",
    "build:store": "npm run verify && npm run games:build && npm run assets && electron-builder --win appx --x64 && npm run package:upload",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-windows-installer.ps1",
    "build:installer": "npm run verify && npm run games:build && npm run assets && npm run package:installer",
    "build:exe": "npm run build:installer",
    "dist": "npm run build:store"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "lucide-vue-next": "0.468.0",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vue": "3.5.38",
    "vue-i18n": "11.4.0"
  },
  "build": {
    "appId": "ShenPulse.ShenPulse",
    "productName": "ShenPulse",
    "buildVersion": "1.0.9.1",
    "buildNumber": "1",
    "copyright": "Copyright © 2026 ShenPulse",
    "asar": true,
    "asarUnpack": [
      "resources/packs/**",
      "resources/irl-python/**"
    ],
    "files": [
      "src/**/*",
      "resources/**/*",
      "build/icon.png",
      "build/shenpulse.ico",
      "package.json",
      "README.md",
      "PRIVACY.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "ShenPulse-${buildVersion}-${arch}.${ext}",
    "win": {
      "target": [
        "appx"
      ],
      "icon": "build/shenpulse.ico",
      "electronLanguages": [
        "fr",
        "en-US"
      ],
      "verifyUpdateCodeSignature": false
    },
    "appx": {
      "applicationId": "ShenPulse",
      "identityName": "ShenPulse.ShenPulse",
      "publisher": "CN=F6F04997-3A7F-4EC3-8492-5BB9FCC0FE46",
      "publisherDisplayName": "ShenPulse",
      "displayName": "ShenPulse",
      "backgroundColor": "#090B14",
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0",
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "privateNetworkClientServer"
      ],
      "languages": [
        "fr-FR",
        "en-US"
      ],
      "showNameOnTiles": true,
      "setBuildNumber": true
    },
    "nsis": {
      "artifactName": "ShenPulseSetup-${buildVersion}-${arch}.${ext}",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ShenPulse",
      "uninstallDisplayName": "ShenPulse ${buildVersion}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "tiktok-live-connector": "2.1.1-beta1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "axios": "^1.17.0",
    "protobufjs": "^7.5.5"
  }
}
